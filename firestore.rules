rules_version = '2';

// Firestore security rules for Disney Pin Vault.
// Principle: users can only change their own data. Other signed-in users can
// only see pins marked "For Trade", and trades are visible only to the two people involved.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function validPin(pin) {
      return pin.name is string
        && pin.name.size() > 0 && pin.name.size() <= 200
        && pin.status in ['own', 'trade', 'iso'];
    }

    // Public profile (display name only; never store email or private data here)
    match /users/{userId} {
      allow read: if signedIn();
      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasOnly(['displayName', 'updatedAt'])
        && (!('displayName' in request.resource.data)
            || (request.resource.data.displayName is string
                && request.resource.data.displayName.size() <= 80));
      allow delete: if false;

      // Each user's collection
      match /pins/{pinId} {
        // Owner sees everything. Everyone else sees only pins marked for trade.
        allow read: if isOwner(userId)
          || (signedIn() && resource.data.status == 'trade');
        allow create, update: if isOwner(userId) && validPin(request.resource.data);
        allow delete: if isOwner(userId);
      }
    }

    // Trade offers between two collectors
    match /trades/{tradeId} {
      allow read: if signedIn()
        && (resource.data.fromUserId == request.auth.uid
            || resource.data.toUserId == request.auth.uid);

      // You can only send offers as yourself, to someone else, starting as "pending"
      allow create: if signedIn()
        && request.resource.data.fromUserId == request.auth.uid
        && request.resource.data.toUserId is string
        && request.resource.data.toUserId != request.auth.uid
        && request.resource.data.status == 'pending';

      // Only the recipient can accept/decline, and only status fields may change
      allow update: if signedIn()
        && resource.data.toUserId == request.auth.uid
        && resource.data.status in ['pending', 'countered']
        && request.resource.data.status in ['accepted', 'declined']
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'respondedAt']);

      allow delete: if false;
    }

    // Everything else is locked
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
